{
  "content_generation": {
    "enabled": true,
    "frequency": "weekly",
    "schedule": "Sunday 23:00 UTC",
    "items_per_run": {
      "min": 2,
      "max": 3
    },
    "content_types": [
      "project",
      "case_study",
      "skill",
      "service"
    ],
    "output_formats": [
      "html",
      "markdown"
    ],
    "output_directory": "content/"
  },
  "ai_config": {
    "provider": "openai",
    "model": "gpt-3.5-turbo",
    "temperature": 0.7,
    "max_tokens": 500
  },
  "github_actions": {
    "workflow_file": ".github/workflows/generate-portfolio.yml",
    "trigger": "schedule",
    "auto_commit": true,
    "auto_deploy": true
  }
}
